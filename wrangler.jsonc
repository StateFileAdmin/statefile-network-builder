{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "network-builder",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-07",
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  // Keep both false. Access cannot protect a workers.dev or preview URL, and
  // the app has no login of its own — either one publishes an unauthenticated
  // copy of your register. See README step 4.
  "workers_dev": false,
  "preview_urls": false,

  "routes": [
    { "pattern": "REPLACE-ME.example.com", "custom_domain": true }
  ],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "network-builder",
      "database_id": "REPLACE-ME-WITH-YOUR-D1-DATABASE-ID"
    }
  ],

  // Public identifiers for your Access application, not secrets.
  "vars": {
    "ACCESS_TEAM_DOMAIN": "REPLACE-ME.cloudflareaccess.com",
    "ACCESS_AUD": "REPLACE-ME-WITH-YOUR-ACCESS-AUD-TAG"
  },

  "observability": { "enabled": true }
}
