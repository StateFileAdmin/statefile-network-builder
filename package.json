{
  "name": "statefile-network-builder",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:cloud": "tsc -b && vite build --mode cloud",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false && tsc -p tsconfig.worker.json --pretty false",
    "dev:cloud": "npm run build:cloud && wrangler dev",
    "db:init:local": "wrangler d1 execute network-builder --local --file=db/schema.sql",
    "db:init:remote": "wrangler d1 execute network-builder --remote --file=db/schema.sql",
    "deploy": "npm run build:cloud && wrangler deploy",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run format:check && npm run typecheck && npm run build && npm run build:cloud"
  },
  "dependencies": {
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.1",
    "@xyflow/react": "^12.8.5",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260907.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "prettier": "^3.6.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "wrangler": "^4.129.0"
  }
}
